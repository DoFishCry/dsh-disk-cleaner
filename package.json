{
  "name": "@local/dsh-garbage-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GarbageMaster: a Linux disk-space scanner, rule-based explainer, and guarded cleanup console for the DSH Web UI.",
  "license": "CC-BY-NC-4.0",
  "author": "DoFishCry",
  "homepage": "https://github.com/DoFishCry/dsh-disk-cleaner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoFishCry/dsh-disk-cleaner.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "disk-cleaner",
    "disk-space",
    "linux"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "core",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node tests/smoke.mjs",
    "test:render": "node tests/render.mjs",
    "test:ui": "node tests/ui-audit.mjs",
    "test:all": "node tests/smoke.mjs && node tests/render.mjs && node tests/ui-audit.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
